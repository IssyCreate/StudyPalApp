<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="StudyPalApp.TermsPage"
             Title="TermsPage">

    <!-- Background -->
    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FA08F5" Offset="0.0"/>
            <GradientStop Color="#8B5CF6" Offset="1.0"/>
        </LinearGradientBrush>
    </ContentPage.Background>

    <!-- Layout FIXED with Grid -->
    <Grid RowDefinitions="Auto,*">

        <!-- Title -->
        <Label 
            Text="Terms and Conditions"
            FontAttributes="Bold"
            FontSize="20"
            HorizontalOptions="Center"
            Margin="0,20,0,10"
            Grid.Row="0"/>

        <!-- Scrollable Content -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="15" Spacing="10">

                <Label Text="Introduction" FontAttributes="Bold"/>
                <Label Text="Welcome to StudyPal. By using our app you are consenting to our policy of use. Please read the terms and conditions before continuing."/>

                <Label Text="1. Educational Purpose" FontAttributes="Bold"/>
                <Label Text="StudyPal provides AI-powered learning assistance, organizational tools, and learning resources. Always verify information from authoritative sources for academic work."/>

                <Label Text="2. AI Assistant Disclaimer" FontAttributes="Bold"/>
                <Label Text="Our AI study partner provides general guidance and support. Responses are generated by AI and should not be considered a replacement for medical advice, professional tutoring, or counselling. For mental concerns, please contact a certified medical professional."/>

                <Label Text="3. Data and Privacy" FontAttributes="Bold"/>
                <Label Text="We collect and process study data, quiz responses, and interaction history to improve responses. Your data remains encrypted and will not be shared with third parties without consent. You can choose to delete your data at any time."/>

                <Label Text="4. User Responsibility" FontAttributes="Bold"/>
                <Label Text="You are responsible for:"/>
                <Label Text="• Maintaining account security"/>
                <Label Text="• Providing accurate information in assignments and notes"/>
                <Label Text="• Following your institution's academic integrity policy"/>
                <Label Text="• Not sharing inappropriate or harmful content"/>

                <Label Text="5. Limitation of Liability" FontAttributes="Bold"/>
                <Label Text="StudyPal is provided 'as is' with no warranties. We are not liable for academic outcomes, missed deadlines, or decisions made based on app content. Features like timers and reminders are tools to assist you, not guarantees."/>

                <Label Text="6. Changes to Services" FontAttributes="Bold"/>
                <Label Text="We reserve the right to modify, suspend, or discontinue features at any time. Free tier limitations may change. Users will be notified of significant updates via email or in-app notifications."/>

                <!-- Agreement Section -->
                <CheckBox x:Name="agreeCheck"/>
                <Label Text="I have read and agree to the Terms and Conditions. I understand StudyPal is a tool and not a replacement for professional advice."/>

                <!-- Continue Button -->
                <Button x:Name="continueBtn"
                        Text="Continue"
                        FontAttributes="Bold"
                        TextColor="Purple"
                        BorderColor="Black"
                        Clicked="OnContinueClicked"/>

            </VerticalStackLayout>
        </ScrollView>

    </Grid>
</ContentPage>