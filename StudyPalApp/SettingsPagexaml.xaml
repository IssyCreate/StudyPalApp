<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="StudyPalApp.SettingsPagexaml"
             Title="SettingsPagexaml">
    <VerticalStackLayout>
        <ContentPage>
            <VerticalStackLayout Padding="20" Spacing="15">

                <Label Text="User Settings"
               FontSize="24"
               FontAttributes="Bold" />

                <Label Text="Name: {Binding Name}" />

                <Button Text="Logout" />
                <Label Text="Under construction"/>

            </VerticalStackLayout>
        </ContentPage>
    </VerticalStackLayout>
</ContentPage>