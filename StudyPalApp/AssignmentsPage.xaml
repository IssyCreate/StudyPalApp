<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:StudyPalApp"
             x:Class="StudyPalApp.AssignmentsPage"
             Title="AssignmentsPage"
              BackgroundColor="#F7F7FB">

    <!-- HEADER / CONTENT / NAV -->
    <Grid RowDefinitions="Auto,*,Auto">

        <!-- ================= HEADER ================= -->
        <Label Text="Assignments"
               Grid.Row="0"
               FontSize="22"
               FontAttributes="Bold"
               Padding="20,10"
               TextColor="Black"/>
        <!--Clover Banner-->
        <Frame x:Name="bannerFrame"
CornerRadius="20"
Padding="15"
Margin="10"
BackgroundColor="Purple">

            <HorizontalStackLayout Spacing="10">

                <Image x:Name="cloverImage"
        Source="clover.png"
        HeightRequest="40"
        WidthRequest="40" />

                <VerticalStackLayout>
                    <Label Text="Clover says:"
            FontAttributes="Bold"
            TextColor="White"/>

                    <Label x:Name="CloverMessage"
            Text="Loading..."
            TextColor="White"/>
                </VerticalStackLayout>

            </HorizontalStackLayout>
        </Frame>
        <!-- ================= CONTENT ================= -->
        <ScrollView Grid.Row="1">

            <VerticalStackLayout Padding="20"
                                 Spacing="15">

                <!-- ADD ASSIGNMENT -->
                <Border Stroke="#DDD"
                        StrokeShape="RoundRectangle 12"
                        Padding="15">

                    <VerticalStackLayout Spacing="10">

                        <Label Text="Add New Assignment"
                               FontAttributes="Bold"
                               TextColor="Black"/>

                        <Entry x:Name="titleEntry"
                               Placeholder="Assignment Title"
                               TextColor="Black"/>

                        <Entry x:Name="subjectEntry"
                               Placeholder="Subject"
                               TextColor="Black"/>

                        <!-- INSTRUCTIONS -->
                        <Editor x:Name="instructionsEditor"
                                Placeholder="Instructions / Details"
                                AutoSize="TextChanges"
                                HeightRequest="100"
                                TextColor="Black"/>

                        <!-- DATE -->
                        <DatePicker x:Name="dueDatePicker"
                                    TextColor="Black"/>

                        <!-- TIME -->
                        <TimePicker x:Name="dueTimePicker"
                                    TextColor="Black"/>

                        <Button Text="Add Assignment"
                                Clicked="OnAddAssignmentClicked"/>

                    </VerticalStackLayout>

                </Border>

                <!-- ASSIGNMENT LIST -->
                <Label Text="Your Assignments"
                       FontAttributes="Bold"
                       TextColor="Black"/>

                <CollectionView x:Name="assignmentList">

                    <CollectionView.ItemTemplate>

                        <DataTemplate x:DataType="local:AssignmentModel">

                            <Border Stroke="#DDD"
                                    StrokeShape="RoundRectangle 10"
                                    Padding="10"
                                    Margin="0,5">

                                <VerticalStackLayout Spacing="5">

                                    <Label Text="{Binding title}"
                                           FontAttributes="Bold"
                                           TextColor="Black"/>

                                    <Label Text="{Binding subject}"
                                           TextColor="Black"/>

                                    <Label Text="{Binding instructions}"
                                           FontSize="12"
                                           TextColor="Gray"/>

                                    <Label Text="{Binding due_date}"
                                           FontSize="12"
                                           TextColor="Gray"/>

                                    <Label Text="{Binding due_time}"
                                           FontSize="12"
                                           TextColor="Gray"/>

                                </VerticalStackLayout>

                            </Border>

                        </DataTemplate>

                    </CollectionView.ItemTemplate>

                </CollectionView>

            </VerticalStackLayout>

        </ScrollView>

       

    </Grid>

</ContentPage>